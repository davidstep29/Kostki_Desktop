<Window x:Class="kosteczkidesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kosteczkidesktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid Background="#ED27C121">
        
        <Grid Height="300px" Width="300px">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Width="100" Background="Transparent" BorderBrush="Transparent" Name="btn1_img" Click="btn1_img_Click">
                <Image Source="/images/kosc0.png" Name="img_1"/>
            </Button>

            <Button Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Width="100" Background="Transparent" BorderBrush="Transparent" Name="btn2_img" Click="btn2_img_Click"> 
                <Image Source="/images/kosc0.png" Name="img_2"/>
            </Button>

            <Button Grid.Column="0" Grid.Row="1" Width="100" Background="Transparent" BorderBrush="Transparent" Name="btn3_img" Click="btn3_img_Click" >
                <Image Source="/images/kosc0.png" Name="img_3"/>
            </Button>

            <Button Grid.Column="1" Grid.Row="1" Width="100" Background="Transparent" BorderBrush="Transparent" Name="btn4_img" Click="btn4_img_Click">
                <Image Source="/images/kosc0.png" Name="img_4"/>
            </Button>

            <Button Grid.Column="2" Grid.Row="1" Width="100" Background="Transparent" BorderBrush="Transparent" Name="btn5_img" Click="btn5_img_Click">
                <Image Source="/images/kosc0.png" Name="img_5"/>
            </Button>

            <Button Content="RZUT" Grid.Row="2" Grid.Column="1" Width="50" Height="30" Margin="0 -50 0 0" Name="rzuc_btn" Background="#ED275021" Foreground="White" Click="rzuc_btn_Click"/>
            <TextBlock Text="0" Grid.Row="2" Grid.Column="1" Width="50" Height="30" TextAlignment="Center" Margin="0 20 0 -15" FontSize="16px" Name="Wynik"/>
        </Grid>
    </Grid>
</Window>
